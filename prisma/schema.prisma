generator client {
  provider = "prisma-client"
  output   = "../packages/backend/src/database/generated"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  CUSTOMER
  STAFF
  MANAGER
  ADMIN
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum ProductStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum OrderStatus {
  DRAFT
  PLACED
  PENDING_CONFIRMATION
  ACCEPTED
  PREPARING
  READY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum OrderChannel {
  WEB
  MOBILE
  STAFF
}

enum StockMovementType {
  PURCHASE
  ADJUSTMENT
  CONSUMPTION
  WASTE
  RETURN
}

enum LoyaltyEntryType {
  EARN
  REDEEM
  ADJUST
  EXPIRE
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum ConversationChannel {
  WEB
  MOBILE
  WHATSAPP
  FUTURE_VOICE
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum ConversationMessageStatus {
  RECEIVED
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum ProviderProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  DUPLICATE
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  AUTHORIZED
  PAID
  FAILED
  CANCELED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

enum RuntimeConfigScope {
  PRICING
  PROMOTIONS
  PAYMENTS
  LOYALTY
  AI_ROUTING
  AI_PROVIDER
  WHATSAPP
  INSTAGRAM
  PROVIDERS
  NOTIFICATIONS
  FEATURE_FLAGS
  HOMEPAGE
  APP
  RECOMMENDATIONS
  OBSERVABILITY
}

enum OrderPaymentState {
  UNPAID
  PAYMENT_PENDING
  PAID
  PAYMENT_FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_ITEM
}

enum PromotionStatus {
  DRAFT
  APPROVED
  ACTIVE
  PAUSED
  EXPIRED
  ARCHIVED
}

enum ProductMediaDraftStatus {
  DRAFT
  APPROVED
  REJECTED
  PUBLISHED
  ARCHIVED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  ARCHIVE
  RESTORE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  EXPORT
}

enum CmsResourceType {
  PAGE
  SECTION
  NAVIGATION
  BANNER
  CAMPAIGN
  LANDING_PAGE
}

enum CmsContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum CmsApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  email           String           @unique @db.VarChar(255)
  name            String           @db.VarChar(120)
  passwordHash    String           @map("password_hash") @db.Text
  isActive        Boolean          @default(true) @map("is_active")
  emailVerifiedAt DateTime?        @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions        Session[]
  roles           UserRole[]
  customerProfile CustomerProfile?

  @@index([email])
  @@map("users")
}

model CustomerProfile {
  id                String                   @id @default(uuid()) @db.Uuid
  userId            String                   @unique @map("user_id") @db.Uuid
  displayName       String?                  @map("display_name") @db.VarChar(120)
  phone             String?                  @db.VarChar(32)
  birthMonth        Int?                     @map("birth_month")
  notes             String?                  @db.Text
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses         CustomerAddress[]
  preferences       CustomerPreference[]
  favorites         CustomerFavorite[]
  savedOrders       SavedOrder[]
  orders            CafeOrder[]
  couponRedemptions CouponRedemption[]
  reviews           ProductReview[]
  recommendations   AiRecommendationRecord[]
  loyalty           LoyaltyAccount?
  notifications     Notification[]
  conversations     Conversation[]

  @@index([phone])
  @@map("customer_profiles")
}

model CustomerAddress {
  id         String          @id @default(uuid()) @db.Uuid
  customerId String          @map("customer_id") @db.Uuid
  type       AddressType     @default(HOME)
  label      String?         @db.VarChar(80)
  line1      String          @map("line_1") @db.VarChar(180)
  line2      String?         @map("line_2") @db.VarChar(180)
  city       String          @db.VarChar(80)
  country    String          @db.VarChar(80)
  isDefault  Boolean         @default(false) @map("is_default")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

model CustomerPreference {
  id         String          @id @default(uuid()) @db.Uuid
  customerId String          @map("customer_id") @db.Uuid
  key        String          @db.VarChar(80)
  value      Json
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, key])
  @@map("customer_preferences")
}

model ProductCategory {
  id        String           @id @default(uuid()) @db.Uuid
  brandKey  String           @default("SALORA") @map("brand_key") @db.VarChar(40)
  slug      String           @unique @db.VarChar(120)
  name      String           @db.VarChar(120)
  nameAr    String?          @map("name_ar") @db.VarChar(120)
  nameEn    String?          @map("name_en") @db.VarChar(120)
  sortOrder Int              @default(0) @map("sort_order")
  products  CatalogProduct[]

  @@map("product_categories")
}

model CatalogProduct {
  id                String                   @id @default(uuid()) @db.Uuid
  brandKey          String                   @default("SALORA") @map("brand_key") @db.VarChar(40)
  categoryId        String                   @map("category_id") @db.Uuid
  slug              String                   @unique @db.VarChar(140)
  name              String                   @db.VarChar(160)
  nameAr            String?                  @map("name_ar") @db.VarChar(160)
  nameEn            String?                  @map("name_en") @db.VarChar(160)
  description       String                   @db.Text
  descriptionAr     String?                  @map("description_ar") @db.Text
  descriptionEn     String?                  @map("description_en") @db.Text
  status            ProductStatus            @default(DRAFT)
  basePrice         Decimal                  @map("base_price") @db.Decimal(10, 3)
  tags              String[]                 @default([])
  pairingHint       String?                  @map("pairing_hint") @db.Text
  aiDescriptor      String?                  @map("ai_descriptor") @db.Text
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  category          ProductCategory          @relation(fields: [categoryId], references: [id])
  variants          ProductVariant[]
  addons            ProductAddon[]
  modifiers         ProductModifier[]
  pricingRules      PricingRule[]
  availabilityRules AvailabilityRule[]
  images            ProductImage[]
  mediaDrafts       ProductMediaDraft[]
  promotionProducts PromotionProduct[]
  reviews           ProductReview[]
  recommendations   AiRecommendationRecord[]
  favorites         CustomerFavorite[]
  orderItems        OrderItem[]
  savedOrders       SavedOrder[]

  @@index([categoryId])
  @@index([brandKey, status])
  @@index([status])
  @@map("catalog_products")
}

model ProductImage {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId     String         @map("product_id") @db.Uuid
  storageBucket String         @default("product-images") @map("storage_bucket") @db.VarChar(120)
  storagePath   String         @map("storage_path") @db.Text
  publicUrl     String?        @map("public_url") @db.Text
  altText       String?        @map("alt_text") @db.VarChar(180)
  sortOrder     Int            @default(0) @map("sort_order")
  isPrimary     Boolean        @default(false) @map("is_primary")
  metadata      Json?
  archivedAt    DateTime?      @map("archived_at") @db.Timestamptz(6)
  deletedAt     DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  product       CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@index([deletedAt])
  @@map("product_images")
}

model ProductMediaDraft {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId          String                  @map("product_id") @db.Uuid
  status             ProductMediaDraftStatus @default(DRAFT)
  source             String                  @default("manual") @db.VarChar(40)
  storageBucket      String                  @default("product-images") @map("storage_bucket") @db.VarChar(120)
  storagePath        String?                 @map("storage_path") @db.Text
  publicUrl          String?                 @map("public_url") @db.Text
  prompt             String?                 @db.Text
  altText            String?                 @map("alt_text") @db.VarChar(180)
  sortOrder          Int                     @default(0) @map("sort_order")
  isPrimaryCandidate Boolean                 @default(false) @map("is_primary_candidate")
  metadata           Json?
  reviewedBy         String?                 @map("reviewed_by") @db.Uuid
  approvedAt         DateTime?               @map("approved_at") @db.Timestamptz(6)
  rejectedAt         DateTime?               @map("rejected_at") @db.Timestamptz(6)
  publishedAt        DateTime?               @map("published_at") @db.Timestamptz(6)
  archivedAt         DateTime?               @map("archived_at") @db.Timestamptz(6)
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  product            CatalogProduct          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, status])
  @@index([status, createdAt])
  @@index([archivedAt])
  @@map("product_media_drafts")
}

model ProductVariant {
  id         String         @id @default(uuid()) @db.Uuid
  productId  String         @map("product_id") @db.Uuid
  name       String         @db.VarChar(120)
  priceDelta Decimal        @default(0) @map("price_delta") @db.Decimal(10, 3)
  sku        String?        @unique @db.VarChar(80)
  product    CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}

model ProductAddon {
  id        String         @id @default(uuid()) @db.Uuid
  productId String         @map("product_id") @db.Uuid
  name      String         @db.VarChar(120)
  price     Decimal        @db.Decimal(10, 3)
  product   CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_addons")
}

model ProductModifier {
  id        String         @id @default(uuid()) @db.Uuid
  productId String         @map("product_id") @db.Uuid
  name      String         @db.VarChar(120)
  options   Json
  required  Boolean        @default(false)
  product   CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_modifiers")
}

model PricingRule {
  id        String         @id @default(uuid()) @db.Uuid
  productId String         @map("product_id") @db.Uuid
  name      String         @db.VarChar(120)
  startsAt  DateTime?      @map("starts_at") @db.Timestamptz(6)
  endsAt    DateTime?      @map("ends_at") @db.Timestamptz(6)
  price     Decimal        @db.Decimal(10, 3)
  product   CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("pricing_rules")
}

model Coupon {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                  String             @unique @db.VarChar(80)
  name                  String             @db.VarChar(140)
  description           String?            @db.Text
  discountType          DiscountType       @map("discount_type")
  discountValue         Decimal            @map("discount_value") @db.Decimal(10, 3)
  currency              String             @default("OMR") @db.VarChar(8)
  minimumOrderTotal     Decimal?           @map("minimum_order_total") @db.Decimal(10, 3)
  maxDiscountAmount     Decimal?           @map("max_discount_amount") @db.Decimal(10, 3)
  usageLimit            Int?               @map("usage_limit")
  usageLimitPerCustomer Int?               @map("usage_limit_per_customer")
  startsAt              DateTime?          @map("starts_at") @db.Timestamptz(6)
  endsAt                DateTime?          @map("ends_at") @db.Timestamptz(6)
  isActive              Boolean            @default(true) @map("is_active")
  metadata              Json?
  archivedAt            DateTime?          @map("archived_at") @db.Timestamptz(6)
  deletedAt             DateTime?          @map("deleted_at") @db.Timestamptz(6)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  redemptions           CouponRedemption[]

  @@index([isActive, startsAt, endsAt])
  @@index([deletedAt])
  @@map("coupons")
}

model CouponRedemption {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  couponId       String           @map("coupon_id") @db.Uuid
  orderId        String           @unique @map("order_id") @db.Uuid
  customerId     String?          @map("customer_id") @db.Uuid
  discountAmount Decimal          @default(0) @map("discount_amount") @db.Decimal(10, 3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  coupon         Coupon           @relation(fields: [couponId], references: [id], onDelete: Restrict)
  order          CafeOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer       CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([couponId, createdAt])
  @@index([customerId, couponId])
  @@map("coupon_redemptions")
}

model Promotion {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug              String             @unique @db.VarChar(140)
  name              String             @db.VarChar(160)
  description       String?            @db.Text
  status            PromotionStatus    @default(DRAFT)
  startsAt          DateTime?          @map("starts_at") @db.Timestamptz(6)
  endsAt            DateTime?          @map("ends_at") @db.Timestamptz(6)
  priority          Int                @default(0)
  rules             Json               @default("{}")
  metadata          Json?
  archivedAt        DateTime?          @map("archived_at") @db.Timestamptz(6)
  deletedAt         DateTime?          @map("deleted_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  promotionProducts PromotionProduct[]

  @@index([status, startsAt, endsAt])
  @@index([deletedAt])
  @@map("promotions")
}

model PromotionProduct {
  promotionId String         @map("promotion_id") @db.Uuid
  productId   String         @map("product_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  promotion   Promotion      @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@index([productId])
  @@map("promotion_products")
}

model AvailabilityRule {
  id          String         @id @default(uuid()) @db.Uuid
  productId   String         @map("product_id") @db.Uuid
  dayOfWeek   Int?           @map("day_of_week")
  startsAt    String?        @map("starts_at") @db.VarChar(8)
  endsAt      String?        @map("ends_at") @db.VarChar(8)
  isAvailable Boolean        @default(true) @map("is_available")
  product     CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("availability_rules")
}

model CustomerFavorite {
  customerId String          @map("customer_id") @db.Uuid
  productId  String          @map("product_id") @db.Uuid
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    CatalogProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([customerId, productId])
  @@map("customer_favorites")
}

model SavedOrder {
  id         String          @id @default(uuid()) @db.Uuid
  customerId String          @map("customer_id") @db.Uuid
  productId  String          @map("product_id") @db.Uuid
  name       String          @db.VarChar(120)
  quantity   Int             @default(1)
  modifiers  Json?
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    CatalogProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("saved_orders")
}

model CafeOrder {
  id               String            @id @default(uuid()) @db.Uuid
  customerId       String?           @map("customer_id") @db.Uuid
  channel          OrderChannel      @default(WEB)
  status           OrderStatus       @default(PLACED)
  paymentState     OrderPaymentState @default(UNPAID) @map("payment_state")
  discountTotal    Decimal           @default(0) @map("discount_total") @db.Decimal(10, 3)
  subtotal         Decimal           @db.Decimal(10, 3)
  total            Decimal           @db.Decimal(10, 3)
  currency         String            @default("OMR") @db.VarChar(8)
  customerName     String?           @map("customer_name") @db.VarChar(120)
  customerPhone    String?           @map("customer_phone") @db.VarChar(32)
  metadata         Json?
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer         CustomerProfile?  @relation(fields: [customerId], references: [id])
  items            OrderItem[]
  timeline         OrderTimeline[]
  notes            OrderNote[]
  conversations    Conversation[]
  payments         Payment[]
  couponRedemption CouponRedemption?
  reviews          ProductReview[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("cafe_orders")
}

model Payment {
  id                String                        @id @default(uuid()) @db.Uuid
  orderId           String                        @map("order_id") @db.Uuid
  customerId        String?                       @map("customer_id") @db.Uuid
  provider          String                        @db.VarChar(80)
  providerPaymentId String?                       @map("provider_payment_id") @db.VarChar(160)
  status            PaymentStatus                 @default(PENDING)
  amount            Decimal                       @db.Decimal(10, 3)
  currency          String                        @default("OMR") @db.VarChar(8)
  idempotencyKey    String                        @unique @map("idempotency_key") @db.VarChar(160)
  metadata          Json?
  authorizedAt      DateTime?                     @map("authorized_at") @db.Timestamptz(6)
  paidAt            DateTime?                     @map("paid_at") @db.Timestamptz(6)
  failedAt          DateTime?                     @map("failed_at") @db.Timestamptz(6)
  canceledAt        DateTime?                     @map("canceled_at") @db.Timestamptz(6)
  createdAt         DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)
  order             CafeOrder                     @relation(fields: [orderId], references: [id])
  intents           PaymentIntent[]
  refunds           Refund[]
  events            PaymentEvent[]
  methodReferences  PaymentMethodReference[]
  auditLogs         PaymentAuditLog[]
  reconciliation    PaymentReconciliationRecord[]

  @@index([orderId])
  @@index([customerId])
  @@index([provider, providerPaymentId])
  @@index([status])
  @@map("payments")
}

model PaymentIntent {
  id                      String        @id @default(uuid()) @db.Uuid
  paymentId               String        @map("payment_id") @db.Uuid
  provider                String        @db.VarChar(80)
  providerPaymentIntentId String?       @map("provider_payment_intent_id") @db.VarChar(160)
  clientSecretReference   String?       @map("client_secret_reference") @db.VarChar(160)
  status                  PaymentStatus @default(PENDING)
  amount                  Decimal       @db.Decimal(10, 3)
  currency                String        @default("OMR") @db.VarChar(8)
  metadata                Json?
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  payment                 Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([provider, providerPaymentIntentId])
  @@map("payment_intents")
}

model Refund {
  id               String       @id @default(uuid()) @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  provider         String       @db.VarChar(80)
  providerRefundId String?      @map("provider_refund_id") @db.VarChar(160)
  status           RefundStatus @default(PENDING)
  amount           Decimal      @db.Decimal(10, 3)
  currency         String       @default("OMR") @db.VarChar(8)
  reason           String?      @db.VarChar(180)
  metadata         Json?
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  payment          Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([provider, providerRefundId])
  @@index([status])
  @@map("refunds")
}

model PaymentEvent {
  id               String                   @id @default(uuid()) @db.Uuid
  paymentId        String?                  @map("payment_id") @db.Uuid
  provider         String                   @db.VarChar(80)
  providerEventId  String                   @map("provider_event_id") @db.VarChar(160)
  eventType        String                   @map("event_type") @db.VarChar(120)
  processingStatus ProviderProcessingStatus @default(RECEIVED) @map("processing_status")
  relatedOrderId   String?                  @map("related_order_id") @db.Uuid
  processedAt      DateTime?                @map("processed_at") @db.Timestamptz(6)
  errorMessage     String?                  @map("error_message") @db.Text
  metadata         Json?
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  payment          Payment?                 @relation(fields: [paymentId], references: [id])

  @@unique([provider, providerEventId])
  @@index([paymentId])
  @@index([relatedOrderId])
  @@index([processingStatus])
  @@map("payment_events")
}

model PaymentMethodReference {
  id         String   @id @default(uuid()) @db.Uuid
  paymentId  String   @map("payment_id") @db.Uuid
  provider   String   @db.VarChar(80)
  methodType String   @map("method_type") @db.VarChar(80)
  reference  String   @db.VarChar(160)
