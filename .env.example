NEXT_PUBLIC_SALORA_SITE_URL=https://salora.cafe
NEXT_PUBLIC_SALORA_WHATSAPP_NUMBER=96800000000
NEXT_PUBLIC_SALORA_INSTAGRAM_URL=https://instagram.com/salora.cafe
NEXT_PUBLIC_SALORA_ANALYTICS_ENABLED=false
NEXT_PUBLIC_SALORA_ENVIRONMENT=production

# Core runtime
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
RELEASE_VERSION=
JSON_BODY_LIMIT=1mb
DIAGNOSTICS_TOKEN=

# Database and queue runtime, required before live commerce/backend launch
DATABASE_URL=
DIRECT_URL=
REDIS_URL=
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_MAX_RETRIES_PER_REQUEST=3
BULL_QUEUE_NAME=salora-jobs
BULL_CONCURRENCY=5
DEAD_LETTER_QUEUE_NAME=salora-dead-letter
QUEUE_PREFIX=salora
QUEUE_CONCURRENCY=5
QUEUE_RETRY_LIMIT=3
QUEUE_BACKOFF_MS=1000
DATABASE_QUERY_TIMEOUT_MS=5000
DATABASE_SLOW_QUERY_MS=750
DATABASE_RETRY_LIMIT=2

# Auth, required before protected admin/customer APIs
JWT_SECRET=
JWT_REFRESH_SECRET=
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=30
AUTH_USE_MEMORY_STORE=false

# AI providers
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AI_DEFAULT_PROVIDER=mock
AI_ENABLE_REAL_PROVIDERS=false
AI_REQUEST_TIMEOUT_MS=15000
AI_MAX_RETRIES=2
AI_DAILY_COST_LIMIT=
AI_SAFETY_LEVEL=strict
AI_PROVIDER_BLACKLIST=
AI_FEATURE_RECOMMENDATIONS=true
AI_FEATURE_KNOWLEDGE=true
AI_PROVIDER_ROLLOUT_ENV=staging
AI_STAGING_REAL_PROVIDERS=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

# Omnichannel customer platform
WHATSAPP_ENABLED=false
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v20.0

# Payments and notifications
STRIPE_SECRET_KEY=
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=mock
STRIPE_ENABLED=false
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_API_VERSION=2025-01-27.acacia
PAYMENT_INTENT_TIMEOUT_MS=15000
PAYMENT_MAX_RETRIES=2
PAYMENT_WEBHOOK_IDEMPOTENCY_TTL_DAYS=30
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_PROJECT_ID=

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0
OTEL_SERVICE_NAME=salora-web
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_ENDPOINT=
OTEL_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_RESOURCE_ATTRIBUTES=service.namespace=salora,deployment.environment=production
OTEL_DEBUG=false

# Mobile public runtime
EXPO_PUBLIC_ENVIRONMENT=production
EXPO_PUBLIC_API_URL=https://salora.cafe
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# CI / release verification
BASE_URL=http://localhost:3000
TIMEOUT_MS=10000
